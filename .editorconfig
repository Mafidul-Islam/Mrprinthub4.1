root = true

[*]
charset = utf-8
end_of_line = LF
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1050.severity = suggestion
dotnet_code_quality.unspecified_fields = warning

[*.{cs,sln,csproj}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = off
