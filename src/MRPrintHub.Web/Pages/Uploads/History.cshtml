@page
@{
    ViewData["Title"] = "Upload History";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-3">Upload History</h1>
            
            <div class="card mb-3">
                <div class="card-body">
                    <p>View upload history for active sessions.</p>
                    <p class="text-muted small">Uploads are stored temporarily and accessible via the Print Hub service.</p>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Token</th>
                            <th>Filename</th>
                            <th>Size</th>
                            <th>Status</th>
                            <th>Uploaded</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>N/A - Connect to service first</td>
                            <td colspan="4">Connect to a Print Hub service to view uploads</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="mt-3">
                <button class="btn btn-primary" onclick="window.location.href='/session/connect'">
                    Refresh Connection
                </button>
            </div>
        </div>
    </div>
</div>