<Window x:Class="MRPrintHub.Desktop.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup Wizard" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MR Print Hub - First Run Setup" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Step 1 of 6: Network Configuration" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Ensure the Windows Service is running and this computer can communicate with it."/>
                <TextBlock Text="IP Address: 127.0.0.1 (default)" Margin="0,5,0,0"/>
                
                <TextBlock Text="Step 2 of 6: Session Configuration" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock Text="Enter a session token for the mobile upload client."/>
                <TextBox x:Name="TokenTextBox" MinWidth="200" Height="25" Margin="0,5,0,0"/>
                
                <TextBlock Text="Step 3 of 6: Port Configuration" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock Text="QR Code port (default 5000):" Margin="0,5,0,0"/>
                <TextBox x:Name="PortTextBox" Width="100" Height="25" Margin="0,5,0,0" Text="5000"/>
                
                <TextBlock Text="Step 4 of 6: QR Code Generation" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock Text="The QR code encodes the upload URL for the mobile client."/>
                <Button Content="Generate QR" Width="100" Height="30" Margin="0,5,0,0" Click="GenerateQrClick"/>
                <Image x:Name="QrImage" Height="150" Width="150" Margin="10,5,0,0" Stretch="Uniform"/>
                
                <TextBlock Text="Step 5 of 6: Confirmation" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock Text="Review your settings and click Finish to complete the setup."/>
                <TextBlock x:Name="StatusTextBlock" Text="" Margin="0,5,0,0" Foreground="Blue"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="Cancel" IsCancel="True" Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Finish" IsDefault="True" Width="80" Height="30" Click="FinishClick"/>
        </StackPanel>
    </Grid>
</Window>