<Window x:Class="MRPrintHub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MR Print Hub"
        Icon="MRPrintHub.ico"
        Height="680" Width="980"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="Auto"/> <!-- Metric Cards Row -->
            <RowDefinition Height="*"/>    <!-- Main Content 2 Columns -->
            <RowDefinition Height="Auto"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#1E40AF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FFFFFF" Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                <Path Fill="#93C5FD" Data="M12 1.5c2.2 0 4 1.8 4 4h-1.5c0-1.38-1.12-2.5-2.5-2.5V1.5z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MR Print Hub" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Direct Mobile-to-PC Print System" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IpBadgeText" Text="IP: 127.0.0.1" FontSize="12" FontWeight="SemiBold" Foreground="#0284C7"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatusBadgeBorder" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusBadgeDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusBadgeText" Text="Local: Connected" FontSize="12" FontWeight="SemiBold" Foreground="#047857"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CloudBadgeBorder" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="CloudBadgeDot" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CloudBadgeText" Text="Cloud: Offline" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Quick Status / Metric Highlights -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Metric 1: Local Service State -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL SERVICE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="MetricServiceText" Text="Connected (Port 5000)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metric 2: Cloud Relay State -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#F0FDF4" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="☁️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CLOUD RELAY" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="MetricCloudText" Text="Offline (Local Only)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metric 3: Total Uploads -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#FAF5FF" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RECEIVED FILES" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="MetricFilesText" Text="0 files received" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Main Dashboard Body (2 Columns) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Modern QR Code Card -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="22" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock Text="Scan to Upload Files" FontSize="17" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="QrSubtitleText" Text="Scan to upload via Local Wi-Fi or 4G/5G Internet" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                    <!-- QR Code Frame -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Background="#FFFFFF" Width="240" Height="240" HorizontalAlignment="Center">
                        <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- URL Display Box -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,16,0,14" Width="320">
                        <TextBlock x:Name="QrUrlText" Text="http://127.0.0.1:5000/u/..." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Width="320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📋 Copy URL" Style="{StaticResource SecondaryButtonStyle}" Click="CopyUrlClick" Height="38"/>
                        <Button Grid.Column="2" Content="🔄 Regenerate QR" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshQrClick" Height="38"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right Panel: Storage & Recent Uploads Feed -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Storage Info Card -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Received Files Storage" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-Save" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="StoragePathText" Text="C:\ProgramData\MRPrintHub\Received" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📂 Open Received Folder" Style="{StaticResource SecondaryButtonStyle}" Height="36" Click="OpenFolderClick"/>
                    </Grid>
                </Border>

                <!-- Recent Uploads Card -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Recent Uploaded Files" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border x:Name="FileCountBadge" Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FileCountBadgeText" Text="0" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                </Border>
                            </StackPanel>
                            <Button Content="🔄 Refresh" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="RefreshUploadsClick"/>
                        </Grid>

                        <!-- Empty State View (Shown when 0 files) -->
                        <Border x:Name="EmptyStateView" Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                                <Border Width="52" Height="52" Background="#EFF6FF" CornerRadius="26" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="📥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No files received yet" FontSize="14" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <TextBlock Text="Files uploaded from customer phones will appear here automatically." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- File Items ListBox (Shown when files exist) -->
                        <ListBox x:Name="UploadsListBox" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- File Icon Badge -->
                                            <Border Grid.Column="0" Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- File Name & Meta -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MetaInfo}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Status Chip -->
                                            <Border Grid.Column="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="✓ Received" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Bottom Footer Bar -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" Padding="14,8" Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BottomStatusText" Text="Server listening on http://127.0.0.1:5000" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TotalUploadsText" Text="Storage: Ready • Local LAN Mode" FontSize="11" Foreground="#94A3B8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
